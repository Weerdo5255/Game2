{
  "title": "Reimagine (structure only)",
  "kind": "background",
  "description": "Background painted from scratch: only the edges of the game painting are kept (ControlNet), not its colours or shading. Freer than the faithful repaint.",
  "defaults": {"control_strength": 0.95, "control_end": 1.0},
  "output_node": "12",
  "prompt": {
    "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Checkpoint"}, "inputs": {"ckpt_name": "$checkpoint"}},
    "2": {"class_type": "LoadImage", "_meta": {"title": "Guide (game painting)"}, "inputs": {"image": "$guide"}},
    "3": {"class_type": "ImageScale", "_meta": {"title": "Scale guide to generation size"}, "inputs": {"image": ["2", 0], "upscale_method": "lanczos", "width": "$width", "height": "$height", "crop": "disabled"}},
    "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive prompt"}, "inputs": {"text": "$positive", "clip": ["1", 1]}},
    "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative prompt"}, "inputs": {"text": "$negative", "clip": ["1", 1]}},
    "6": {"class_type": "Canny", "_meta": {"title": "Edges of the guide"}, "inputs": {"image": ["3", 0], "low_threshold": "$canny_low", "high_threshold": "$canny_high"}},
    "7": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet"}, "inputs": {"control_net_name": "$controlnet"}},
    "8": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "Hold the composition"}, "inputs": {"positive": ["4", 0], "negative": ["5", 0], "control_net": ["7", 0], "image": ["6", 0], "strength": "$control_strength", "start_percent": 0.0, "end_percent": "$control_end", "vae": ["1", 2]}},
    "9": {"class_type": "EmptyLatentImage", "_meta": {"title": "Start from noise"}, "inputs": {"width": "$width", "height": "$height", "batch_size": 1}},
    "10": {"class_type": "KSampler", "_meta": {"title": "Paint from scratch"}, "inputs": {"model": ["1", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "positive": ["8", 0], "negative": ["8", 1], "latent_image": ["9", 0], "denoise": 1.0}},
    "11": {"class_type": "VAEDecode", "_meta": {"title": "Decode"}, "inputs": {"samples": ["10", 0], "vae": ["1", 2]}},
    "12": {"class_type": "SaveImage", "_meta": {"title": "Save"}, "inputs": {"images": ["11", 0], "filename_prefix": "$prefix"}}
  }
}
