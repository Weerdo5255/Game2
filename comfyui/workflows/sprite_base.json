{
  "title": "Faithful portrait",
  "kind": "sprite",
  "description": "Neutral portrait of a character: img2img from the sprite flattened on grey, structure locked by ControlNet, then cut out with the guide's own silhouette (eroded and feathered) so the result has an alpha channel.",
  "output_node": "22",
  "prompt": {
    "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Checkpoint"}, "inputs": {"ckpt_name": "$checkpoint"}},
    "2": {"class_type": "LoadImage", "_meta": {"title": "Guide (sprite on grey)"}, "inputs": {"image": "$guide"}},
    "3": {"class_type": "ImageScale", "_meta": {"title": "Scale guide to generation size"}, "inputs": {"image": ["2", 0], "upscale_method": "lanczos", "width": "$width", "height": "$height", "crop": "disabled"}},
    "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive prompt"}, "inputs": {"text": "$positive", "clip": ["1", 1]}},
    "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative prompt"}, "inputs": {"text": "$negative", "clip": ["1", 1]}},
    "6": {"class_type": "Canny", "_meta": {"title": "Edges of the guide"}, "inputs": {"image": ["3", 0], "low_threshold": "$canny_low", "high_threshold": "$canny_high"}},
    "7": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet"}, "inputs": {"control_net_name": "$controlnet"}},
    "8": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "Hold the pose and silhouette"}, "inputs": {"positive": ["4", 0], "negative": ["5", 0], "control_net": ["7", 0], "image": ["6", 0], "strength": "$control_strength", "start_percent": 0.0, "end_percent": "$control_end", "vae": ["1", 2]}},
    "9": {"class_type": "VAEEncode", "_meta": {"title": "Guide to latent"}, "inputs": {"pixels": ["3", 0], "vae": ["1", 2]}},
    "10": {"class_type": "KSampler", "_meta": {"title": "Repaint (partial denoise)"}, "inputs": {"model": ["1", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "positive": ["8", 0], "negative": ["8", 1], "latent_image": ["9", 0], "denoise": "$denoise"}},
    "11": {"class_type": "VAEDecode", "_meta": {"title": "Decode"}, "inputs": {"samples": ["10", 0], "vae": ["1", 2]}},
    "13": {"class_type": "LoadImage", "_meta": {"title": "Silhouette (white = character)"}, "inputs": {"image": "$silhouette"}},
    "14": {"class_type": "ImageScale", "_meta": {"title": "Scale silhouette"}, "inputs": {"image": ["13", 0], "upscale_method": "bilinear", "width": "$width", "height": "$height", "crop": "disabled"}},
    "15": {"class_type": "ImageToMask", "_meta": {"title": "Silhouette as mask"}, "inputs": {"image": ["14", 0], "channel": "red"}},
    "16": {"class_type": "GrowMask", "_meta": {"title": "Pull the edge in (negative = erode)"}, "inputs": {"mask": ["15", 0], "expand": "$alpha_grow", "tapered_corners": true}},
    "17": {"class_type": "MaskToImage", "inputs": {"mask": ["16", 0]}},
    "18": {"class_type": "ImageBlur", "_meta": {"title": "Feather the edge"}, "inputs": {"image": ["17", 0], "blur_radius": "$alpha_feather", "sigma": "$alpha_sigma"}},
    "19": {"class_type": "ImageToMask", "inputs": {"image": ["18", 0], "channel": "red"}},
    "20": {"class_type": "InvertMask", "_meta": {"title": "JoinImageWithAlpha wants 1 = transparent"}, "inputs": {"mask": ["19", 0]}},
    "21": {"class_type": "JoinImageWithAlpha", "_meta": {"title": "Cut out"}, "inputs": {"image": ["11", 0], "alpha": ["20", 0]}},
    "22": {"class_type": "SaveImage", "_meta": {"title": "Save (RGBA)"}, "inputs": {"images": ["21", 0], "filename_prefix": "$prefix"}}
  }
}
