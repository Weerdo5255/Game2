{
  "title": "Expression from the enhanced neutral",
  "kind": "expression",
  "description": "Another expression of a character whose neutral portrait is already enhanced: start from that enhanced neutral, re-noise ONLY the face region, steer it with the edges of the expression guide and the expression prompt, then paste the new face back over the untouched neutral so identity, hair and clothes cannot drift.",
  "output_node": "32",
  "prompt": {
    "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Checkpoint"}, "inputs": {"ckpt_name": "$checkpoint"}},
    "2": {"class_type": "LoadImage", "_meta": {"title": "Enhanced neutral portrait"}, "inputs": {"image": "$base"}},
    "3": {"class_type": "ImageScale", "_meta": {"title": "Scale neutral to generation size"}, "inputs": {"image": ["2", 0], "upscale_method": "lanczos", "width": "$width", "height": "$height", "crop": "disabled"}},
    "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive prompt (character + expression)"}, "inputs": {"text": "$positive", "clip": ["1", 1]}},
    "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative prompt"}, "inputs": {"text": "$negative", "clip": ["1", 1]}},
    "6": {"class_type": "LoadImage", "_meta": {"title": "Expression guide (sprite on grey)"}, "inputs": {"image": "$guide"}},
    "7": {"class_type": "ImageScale", "_meta": {"title": "Scale expression guide"}, "inputs": {"image": ["6", 0], "upscale_method": "lanczos", "width": "$width", "height": "$height", "crop": "disabled"}},
    "8": {"class_type": "Canny", "_meta": {"title": "Edges of the expression"}, "inputs": {"image": ["7", 0], "low_threshold": "$canny_low", "high_threshold": "$canny_high"}},
    "9": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet"}, "inputs": {"control_net_name": "$controlnet"}},
    "10": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "Hold the expression"}, "inputs": {"positive": ["4", 0], "negative": ["5", 0], "control_net": ["9", 0], "image": ["8", 0], "strength": "$control_strength", "start_percent": 0.0, "end_percent": "$control_end", "vae": ["1", 2]}},
    "11": {"class_type": "VAEEncode", "_meta": {"title": "Neutral to latent"}, "inputs": {"pixels": ["3", 0], "vae": ["1", 2]}},
    "12": {"class_type": "LoadImage", "_meta": {"title": "Face region (white = repaint)"}, "inputs": {"image": "$face"}},
    "13": {"class_type": "ImageScale", "_meta": {"title": "Scale face region"}, "inputs": {"image": ["12", 0], "upscale_method": "bilinear", "width": "$width", "height": "$height", "crop": "disabled"}},
    "14": {"class_type": "ImageToMask", "inputs": {"image": ["13", 0], "channel": "red"}},
    "15": {"class_type": "GrowMask", "_meta": {"title": "Margin round the face"}, "inputs": {"mask": ["14", 0], "expand": "$face_grow", "tapered_corners": true}},
    "16": {"class_type": "MaskToImage", "inputs": {"mask": ["15", 0]}},
    "17": {"class_type": "ImageBlur", "_meta": {"title": "Soften the seam"}, "inputs": {"image": ["16", 0], "blur_radius": "$face_feather", "sigma": "$face_sigma"}},
    "18": {"class_type": "ImageToMask", "inputs": {"image": ["17", 0], "channel": "red"}},
    "19": {"class_type": "SetLatentNoiseMask", "_meta": {"title": "Only the face is re-noised"}, "inputs": {"samples": ["11", 0], "mask": ["18", 0]}},
    "20": {"class_type": "KSampler", "_meta": {"title": "Repaint the face"}, "inputs": {"model": ["1", 0], "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "positive": ["10", 0], "negative": ["10", 1], "latent_image": ["19", 0], "denoise": "$denoise"}},
    "21": {"class_type": "VAEDecode", "_meta": {"title": "Decode"}, "inputs": {"samples": ["20", 0], "vae": ["1", 2]}},
    "22": {"class_type": "ImageCompositeMasked", "_meta": {"title": "New face over the untouched neutral"}, "inputs": {"destination": ["3", 0], "source": ["21", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["18", 0]}},
    "23": {"class_type": "LoadImage", "_meta": {"title": "Silhouette (white = character)"}, "inputs": {"image": "$silhouette"}},
    "24": {"class_type": "ImageScale", "_meta": {"title": "Scale silhouette"}, "inputs": {"image": ["23", 0], "upscale_method": "bilinear", "width": "$width", "height": "$height", "crop": "disabled"}},
    "25": {"class_type": "ImageToMask", "inputs": {"image": ["24", 0], "channel": "red"}},
    "26": {"class_type": "GrowMask", "_meta": {"title": "Pull the edge in (negative = erode)"}, "inputs": {"mask": ["25", 0], "expand": "$alpha_grow", "tapered_corners": true}},
    "27": {"class_type": "MaskToImage", "inputs": {"mask": ["26", 0]}},
    "28": {"class_type": "ImageBlur", "_meta": {"title": "Feather the edge"}, "inputs": {"image": ["27", 0], "blur_radius": "$alpha_feather", "sigma": "$alpha_sigma"}},
    "29": {"class_type": "ImageToMask", "inputs": {"image": ["28", 0], "channel": "red"}},
    "30": {"class_type": "InvertMask", "_meta": {"title": "JoinImageWithAlpha wants 1 = transparent"}, "inputs": {"mask": ["29", 0]}},
    "31": {"class_type": "JoinImageWithAlpha", "_meta": {"title": "Cut out"}, "inputs": {"image": ["22", 0], "alpha": ["30", 0]}},
    "32": {"class_type": "SaveImage", "_meta": {"title": "Save (RGBA)"}, "inputs": {"images": ["31", 0], "filename_prefix": "$prefix"}}
  }
}
